# ---- Database (MySQL) ----
MYSQL_IP=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=omicairn
MYSQL_USER=root
MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>

# data_uploading_check service uses its own variable names
DB_HOST=localhost
DB_PORT=3306
DB_NAME=omicairn
DB_USER=root
DB_PASSWORD=<YOUR_MYSQL_PASSWORD>

# ---- Object storage (S3 / S3-compatible) ----
BUCKET_NAME=<YOUR_BUCKET_NAME>
# e.g. the region of your S3 bucket
AWS_REGION=<YOUR_AWS_REGION>
# Leave empty for AWS S3; set e.g. http://localhost:9000 for MinIO
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>

# Bucket used by the per-user "GPT space" file area
GPT_SPACE_BUCKET=<YOUR_GPT_SPACE_BUCKET>
# Region of the GPT space bucket (falls back to AWS_REGION if empty)
GPT_SPACE_REGION=<YOUR_AWS_REGION>
GPT_SPACE_PREFIX=gpt-space/

# ---- AWS Batch (preprocessing jobs) ----
FB_PP_QUEUE=<YOUR_FB_PREPROCESS_QUEUE>
DATA_PREPROCESSOR_JOB_DEFINITION=<YOUR_DATA_PREPROCESSOR_JOB_DEFINITION>
DATA_PREPROCESSOR_QUEUE=<YOUR_DATA_PREPROCESSOR_QUEUE>
DATA_VITESSCE_PREPROCESSOR_JOB_DEFINITION=<YOUR_VITESSCE_PREPROCESSOR_JOB_DEFINITION>
DATA_VITESSCE_PREPROCESSOR_QUEUE=<YOUR_VITESSCE_PREPROCESSOR_QUEUE>
AWS_BATCH_LOG_GROUP=/aws/batch/job

# ---- Related services ----
# External LLM workflow service (not part of this repository); the worker uses the same values
GPT_SERVER_HOST=localhost
GPT_SERVER_PORT=5000
GPT_WORKFLOW_SERVER_HOST=localhost
GPT_WORKFLOW_SERVER_PORT=5000
# Used only by chat_agent/ (spawned by this backend). Full base URLs WITH scheme and prefix:
#   MAIN_SERVER_HOST        -> this backend itself (no /server prefix; port 80 inside the container,
#                              8000 with the README quick start)
#   COMPUTATION_SERVER_HOST -> the worker, through the gateway's /computation-server prefix
#   DATA_SERVER_HOST        -> optional data-preprocessing service (/pretreatment/*); not part of
#                              this release, the dataset-import tool of the chat agent fails without it
MAIN_SERVER_HOST=http://localhost:80
COMPUTATION_SERVER_HOST=http://localhost:8099/computation-server
DATA_SERVER_HOST=http://localhost:8099/data
# Currently unused (kept for compatibility)
COMPUTATION_IP=localhost

# Optional outbound HTTP proxy (leave empty for direct connections)
NETWORK_PROXY_HOST=
NETWORK_PROXY_PORT=

# ---- Security ----
# Shared secret for internal agents/workers (generate a random value; same value in the worker and
# claude-code). Callers send it in the X-System-Agent-Key header of POST /user/login-by-system
# (the legacy system_agent_key query parameter is still accepted). System login is disabled while unset.
SYSTEM_AGENT_KEY=<YOUR_SYSTEM_AGENT_KEY>
CORS_ORIGINS=http://localhost:3000

# ---- Local storage / misc ----
DATA_FOLDER=
FIGURE_FOLDER=
EXAMPLE_DATA_ID=1
CHAT_AGENT_LOG_DIR=/tmp
LOG_LEVEL=INFO
