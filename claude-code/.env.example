# claude-code executor configuration (names only; fill in your own values)

# Claude authentication (ANTHROPIC_API_KEY is the supported credential for server deployments;
# CLAUDE_CODE_OAUTH_TOKEN is only for local single-user testing)
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
# CLAUDE_CODE_OAUTH_TOKEN=<YOUR_CLAUDE_CODE_OAUTH_TOKEN>
CLAUDE_MODEL=sonnet
MAX_ITERATIONS=100
MAX_LOOP_ITERATIONS=50

# Backend services: base URL of the HTTP gateway that forwards /server/* to the backend and
# /computation-server/* to the worker (the code appends those prefixes). The scheme is optional
# ("localhost:8099" is accepted, which is the form the worker injects into job containers).
MAIN_SERVER_HOST=http://localhost:8080
MAIN_SERVER_ACCESS_PREFIX=http://localhost:8080
COMPUTATION_SERVER_HOST=http://localhost:8080
# Same value as the backend's SYSTEM_AGENT_KEY; sent as the X-System-Agent-Key header
SYSTEM_AGENT_KEY=<YOUR_SYSTEM_AGENT_KEY>

# Job identity (normally injected by the worker that launches the container)
COMPUTATION_ID=<COMPUTATION_ID>
NODE_ID=<NODE_ID>
USER_ID=<USER_ID>

# Object storage (AWS credentials come from the standard AWS SDK chain / IAM role)
BUCKET_NAME=<YOUR_BUCKET_NAME>

# Misc
UPLOAD_INTERVAL=300
PIPE_MESSAGE_PATH=/tmp/pipe-message

# Image build (build-image.sh)
IMAGE_NAME=omicairn-claude-code
PLATFORM=linux/amd64
REGISTRY=<YOUR_REGISTRY>
PUSH=0
