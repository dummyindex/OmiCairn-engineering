# Frontend build/runtime configuration (read by UmiJS at build/dev time).
# Copy to .env and adjust. All values below are placeholders/defaults.

# Base URL of the HTTP gateway (must end with a slash). The UI calls <prefix>server/... (backend),
# <prefix>computation-server/... (worker) and <prefix>data/... (optional data service); see README.md.
UMI_APP_API_URL_PREFIX=http://localhost:8099/

# Object-storage backend for presigned uploads/downloads (currently only "AWS" / S3-compatible).
UMI_APP_SERVICE_CLOUD=AWS

# Base URL for static UI images (logos, icons). Default: /static (served from public/static).
UMI_APP_STATIC_RESOURCE_BASE_URL=/static

# Optional URL of an example function-block package; the "Download Demo" button is hidden if empty.
UMI_APP_DEMO_FUNCTION_BLOCK_URL=

# IANA timezone used by the backend for function-block timestamps (default UTC).
UMI_APP_SERVER_TIMEZONE=UTC
