# Worker configuration. Copy to .env (never commit real values) or export these
# variables before running scripts/launch.sh. scripts/set-local-env-variables.sh
# provides local defaults for most of them.
#
# Security note: most worker HTTP endpoints perform no authentication of their own. Run the
# worker on a private network and expose it only through the gateway described in
# ../frontend/README.md ("Service topology"); never publish its port 80 directly.

# --- Paths inside the worker container ---
OMICAIRN_CODE_SPACE=/omicairn/code_space
OMICAIRN_STORE=/omicairn/store
LOCAL_JOB_QUEUE=/tmp/local-job-queue
LOCAL_JOB_SIGNAL=/tmp/job-signal
RAG_FLAGS_DIR=/rag-flags
FILE_RESOLVER_DIR=/omicairn/code_space/file_resolver
FILE_RESOLVER_PYTHON=/omicairn/venvs/file_resolver_env/bin/python3

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=omicairn
DB_USER=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_DB_PASSWORD>

# --- Object storage (S3-compatible) ---
PORTER_TYPE=s3-porter
BUCKET_NAME=<YOUR_S3_BUCKET>
# Optional separate bucket / AWS profile for Claude Code jobs (defaults: BUCKET_NAME / default credentials)
CLAUDE_CODE_BUCKET_NAME=
CLAUDE_CODE_AWS_PROFILE=
# Standard AWS credential chain variables (or use an instance role / mounted profile)
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=<YOUR_AWS_REGION>

# --- Other OmiCairn services ---
# "host:port" (no scheme) of the HTTP gateway that forwards /server/* to the backend and
# /computation-server/* to this worker (stripping the prefix). The worker appends
# /server/... and /computation-server/... itself and passes both values unchanged to
# claude-code job containers.
MAIN_SERVER_HOST=localhost:8099
COMPUTATION_SERVER_HOST=localhost:8099
# External LLM workflow service (not part of this repository); use the same values as the backend
GPT_SERVER_HOST=localhost
GPT_SERVER_PORT=5000
GPT_WORKFLOW_SERVER_HOST=localhost
GPT_WORKFLOW_SERVER_PORT=5000
# Shared secret for the backend's /user/login-by-system endpoint, sent as the
# X-System-Agent-Key header. Must equal the backend's SYSTEM_AGENT_KEY.
SYSTEM_AGENT_KEY=<YOUR_SYSTEM_AGENT_KEY>

# --- Claude Code agent jobs ---
CLAUDE_CODE_OAUTH_TOKEN=<YOUR_CLAUDE_CODE_OAUTH_TOKEN>
CLAUDE_CODE_JOB_DEFINITION=<YOUR_CLAUDE_CODE_JOB_DEFINITION>
CLAUDE_CODE_JOB_QUEUE=<YOUR_CLAUDE_CODE_JOB_QUEUE>
CLAUDE_CODE_EC2_JOB_DEFINITION=<YOUR_CLAUDE_CODE_EC2_JOB_DEFINITION>
CLAUDE_CODE_EC2_JOB_QUEUE=<YOUR_CLAUDE_CODE_EC2_JOB_QUEUE>

# --- ChromaDB (RAG vector stores) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_TIMEOUT=30
CHROMA_MAX_RETRIES=3
EMBEDDING_MODEL=

# --- Optional outbound HTTP proxy (leave empty for none) ---
NETWORK_PROXY_HOST=
NETWORK_PROXY_PORT=

# --- AWS Batch job definitions / queues (only when system_env = aws-batch) ---
JOB_QUEUE=<YOUR_JOB_QUEUE>
LARGE_JOB_QUEUE=<YOUR_LARGE_JOB_QUEUE>
NOTEBOOK_JOB_DEFINITION=<YOUR_NOTEBOOK_JOB_DEFINITION>
PYTHON_JOB_DEFINITION_SCANPY=<YOUR_PYTHON_JOB_DEFINITION_SCANPY>
PYTHON_JOB_DEFINITION_DYN=<YOUR_PYTHON_JOB_DEFINITION_DYN>
PYTHON_JOB_DEFINITION_MEBOCOST=<YOUR_PYTHON_JOB_DEFINITION_MEBOCOST>
PYTHON_JOB_DEFINITION_SCVELO=<YOUR_PYTHON_JOB_DEFINITION_SCVELO>
PYTHON_JOB_DEFINITION_SCFATES=<YOUR_PYTHON_JOB_DEFINITION_SCFATES>
PYTHON_JOB_DEFINITION_DEFAULT=<YOUR_PYTHON_JOB_DEFINITION_DEFAULT>
PYTHON_JOB_DEFINITION_V2=<YOUR_PYTHON_JOB_DEFINITION_V2>
PYTHON_JOB_DEFINITION_DEFAULT_V2=<YOUR_PYTHON_JOB_DEFINITION_DEFAULT_V2>
PYTHON_JOB_DEFINITION_LARGE_DEFAULT_V2=<YOUR_PYTHON_JOB_DEFINITION_LARGE_DEFAULT_V2>
PYTHON_JOB_DEFINITION_SCANPY_V2=<YOUR_PYTHON_JOB_DEFINITION_SCANPY_V2>
PYTHON_JOB_DEFINITION_DYN_V2=<YOUR_PYTHON_JOB_DEFINITION_DYN_V2>
PYTHON_JOB_DEFINITION_MEBOCOST_V2=<YOUR_PYTHON_JOB_DEFINITION_MEBOCOST_V2>
PYTHON_JOB_DEFINITION_SCVELO_V2=<YOUR_PYTHON_JOB_DEFINITION_SCVELO_V2>
PYTHON_JOB_DEFINITION_SCFATES_V2=<YOUR_PYTHON_JOB_DEFINITION_SCFATES_V2>
R_JOB_DEFINITION=<YOUR_R_JOB_DEFINITION>
R_JOB_DEFINITION_V2=<YOUR_R_JOB_DEFINITION_V2>
R_JOB_DEFINITION_V2_METABOANALYST=<YOUR_R_JOB_DEFINITION_V2_METABOANALYST>
BASH_JOB_DEFINITION=<YOUR_BASH_JOB_DEFINITION>

# --- Dynamic generation ---
# Database IDs of the seeded "First Step" function block / version used by v2 dynamic generation
DEFAULT_V2_FUNCTION_BLOCK_ID=151
DEFAULT_V2_FUNCTION_BLOCK_VERSION_ID=164

# --- Misc ---
DEPLOY_ENV=local
LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=UTC
PERFORMANCE_TIMING_ENABLED=false
